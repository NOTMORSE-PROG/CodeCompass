# =============================================================
# CodeCompass Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# =============================================================

# Django Core
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database — Neon PostgreSQL
# Get this from your Neon dashboard → Connection Details → Connection string
DATABASE_URL=postgresql://username:password@ep-xxx-xxx.ap-southeast-1.aws.neon.tech/codecompass?sslmode=require

# Redis (local for dev, Upstash for production)
# Local dev:    redis://localhost:6379/0
# Upstash prod: rediss://default:password@xxx.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# AI — Groq API
# Get free API key at: https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# YouTube Data API v3
# Get free API key at: https://console.cloud.google.com → YouTube Data API v3
YOUTUBE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth — Client ID
# Create at: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized JS origins: http://localhost:5173  |  Prod: https://your-app.vercel.app
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Careerjet (primary PH job source — free partner account)
# Sign up at: https://www.careerjet.com/partners/api
CAREERJET_AFFID=your_32_char_careerjet_affiliate_id

# JSearch via RapidAPI (fallback — 200 free req/month, aggregates Google Jobs PH)
# Sign up at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_RAPIDAPI_KEY=your_rapidapi_key_here

# CORS — Frontend origin(s), comma-separated
# Dev:  http://localhost:5173
# Prod: https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (for password reset emails)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# Frontend URL (used in password reset email links)
FRONTEND_URL=http://localhost:5173
