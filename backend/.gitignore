# =============================================================
# CodeCompass Backend — .gitignore
# =============================================================

# Environment — NEVER commit secrets
.env
.env.local
.env.*.local

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environment
venv/
env/
.venv/
ENV/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
staticfiles/
media/
/media/

# Migrations (keep these tracked — they define your schema)
# Do NOT add apps/*/migrations/ here

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Celery
celerybeat-schedule
celerybeat.pid

# mypy / type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Editor
.vscode/
.idea/
*.suo
*.sw?

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
